# PostgreSQL connection string (Railway provides this automatically in production)
DATABASE_URL="postgresql://user:password@localhost:5432/rachai?schema=public"

# Port the HTTP server listens on
PORT=3000

# Origin allowed to call the API (the deployed frontend URL, no trailing slash)
CORS_ORIGIN="http://localhost:5173"

# Secret used to sign group session tokens and admin session tokens (32+ random bytes)
JWT_SECRET="replace-with-a-long-random-string"

# Seed credentials for the first admin account (only read once, on first boot)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
