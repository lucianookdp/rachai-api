# PostgreSQL connection string (Railway provides this automatically in production)
DATABASE_URL="postgresql://user:password@localhost:5432/rachai?schema=public"

# Port the HTTP server listens on
PORT=3000

# Origins allowed to call the API, comma-separated (no trailing slash on any of them)
CORS_ORIGIN="http://localhost:5173"

# Secret used to sign group session tokens and admin session tokens (32+ random bytes)
JWT_SECRET="replace-with-a-long-random-string"

# Optional. Set only once the frontend and this API are subdomains of the same
# registrable domain (e.g. ".userachai.com.br"), so the admin cookie can be
# shared across both instead of being dropped as a third-party cookie.
COOKIE_DOMAIN=

# Seed credentials for the first admin account (only read once, on first boot)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
